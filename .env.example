# ============ 数据库 ============
# 默认使用内置 PostgreSQL（docker-compose 的 postgres 服务，数据卷 postgres-data）。
# 如需回退零依赖 SQLite（文件在 ./data），改成下面这行：
# SG_DATABASE_URL=sqlite:///./data/gateway.db
# 外部独立 PG 实例则填：postgresql+psycopg://user:pass@host:5432/db
# （compose 里的实际默认值见 docker-compose.yml，本文件仅作示例）
SG_DATABASE_URL=postgresql+psycopg://sg:sgpass@postgres:5432/sgateway

# ============ 管理后台 ============
SG_ADMIN_AUTH_ENABLED=true
SG_ADMIN_USERNAME=admin
SG_ADMIN_PASSWORD=admin123

# ============ 密钥 ============
# 留空则自动生成并持久化到数据目录的 .secrets.json（权限 0600）。
# 该路径固定在数据目录、与数据库类型无关；生产建议显式固定下面两项，
# 避免误删文件导致已加密凭证无法解密：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SG_JWT_SECRET=
# SG_FERNET_KEY=
# 也可直接锁定密钥文件路径（默认 /app/data/.secrets.json）：
# SG_SECRETS_FILE=/app/data/.secrets.json

# ============ 运行 ============
SG_HOST=0.0.0.0
SG_PORT=8000
SG_PROXY_TIMEOUT=120
SG_CORS_ORIGINS=*

# ============ API Key ============
SG_API_KEY_PREFIX=sg_sk_
SG_DEFAULT_RATE_LIMIT_PER_MIN=0
